+    if [ -n "$STILL" ]; then journal env-not-cleared "$STILL"; page error "TEARDOWN INCOMPLETE $RUN: canary env still live in $STILL -- restart those units"; else journal env-cleared "$CENV_KEYS"; fi
+  fi
   page verdict "$FINAL $RUN; torn down; pools live: $LIVE"
 }
 
