+    F.write_reg({'sha': F.canary[:7], 'reads': ['fooread', 'immobiledid'], 'draw_exposure': {'require': []},
+                 'draw_require_pools': ['board-b', 'hive-a', 'hive-b']})
+    F.enqueue(CS)
+    expect(CS, F, 'wait', 'R10', 'fewer than two pools', FIX_DE='few')
+
+
