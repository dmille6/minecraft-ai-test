+def t_r10_wait_pages_decision(CS, F):
+    """The W4 decision as behaviour: a flag past 3 h naming the floor (two; four for tier 2); a tier-2 ERROR with both
+    remedies from 12 h, never before; an untiered wait never gets the error, however long."""
+    p = CS.r10_wait_pages('r1', 2.9, True, 'x')
+    assert p == [], p
+    p = CS.r10_wait_pages('r1', 3.1, True, 'x')
+    assert [l for l, _k, _m in p] == ['flag'] and 'fewer than four pools' in p[0][2], p
+    p = CS.r10_wait_pages('r1', 11.9, True, 'x')
+    assert [l for l, _k, _m in p] == ['flag'], p
+    p = CS.r10_wait_pages('r1', 12.0, True, 'x')
+    assert [l for l, _k, _m in p] == ['flag', 'error'], p
+    assert 'replace-variant r1' in p[1][2] and 'queue hold r1' in p[1][2] and 'NOT deployed' in p[1][2], p
+    p = CS.r10_wait_pages('r1', 40.0, False, 'x')
+    assert [l for l, _k, _m in p] == ['flag'] and 'fewer than two pools' in p[0][2], p
+
+
+def _tick_at(CS, F, hours, **extra):
+    t = NOW + dt.timedelta(hours=hours)
+    for b in BOTS:
+        F.log(b, t - dt.timedelta(minutes=1), F.base[:7] + '+abc123')
+    with Env(F.env(SCHED_FAKE_NOW=Z(t), **extra)):
+        assert CS.tick(CS.paths()) == 0
+
+
+def t_w4_tier2_r10_wait_bounded_at_12h(CS, F):
+    """A tier-2 head that only two pools can expose: flagged at 3 h ('four'), an ERROR with the remedies at 12 h, and
+    it is still not launched (the wait goes on; a block would halt the serial queue no differently)."""
+    _t2_reg(F); F.enqueue(CS)
+    _tick_at(CS, F, 0, FIX_DE='ok')
+    _tick_at(CS, F, 3.1, FIX_DE='ok')
+    pg = open(os.path.join(F.home, 'digest', 'page.jsonl')).read()
+    assert 'fewer than four pools' in pg and 'r10wait-t2' not in pg and '12-h tier-2 bound' not in pg, pg
+    _tick_at(CS, F, 12.1, FIX_DE='ok')
+    pg = [json.loads(l) for l in open(os.path.join(F.home, 'digest', 'page.jsonl')) if l.strip()]
+    err = [x for x in pg if x['level'] == 'error' and '12-h tier-2 bound' in x['msg']]
+    assert len(err) == 1 and 'replace-variant' in err[0]['msg'], pg
+    expect(CS, F, 'wait', 'R10', 'four pools', FIX_DE='ok', SCHED_FAKE_NOW=Z(NOW + dt.timedelta(hours=12, minutes=10)))
+
+
+def t_w4_tier3_r10_wait_never_errors(CS, F):
+    """Positive control: an untiered head waiting on R10 (one exposure pool) pages the flag ('two') and never the
+    tier-2 error, even at 13 h."""
+    F.write_reg({'sha': F.canary[:7], 'reads': ['fooread', 'immobiledid'], 'draw_exposure': {'require': []}})
+    F.enqueue(CS)
+    _tick_at(CS, F, 0, FIX_DE='few')
+    _tick_at(CS, F, 13, FIX_DE='few')
+    pg = open(os.path.join(F.home, 'digest', 'page.jsonl')).read()
+    assert 'fewer than two pools' in pg and '12-h tier-2 bound' not in pg, pg
+
