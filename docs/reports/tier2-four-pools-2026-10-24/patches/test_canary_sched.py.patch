 def t_r10_undeclared_must_say_so(CS, F):
     F.enqueue(CS); expect(CS, F, 'block', 'R10', FIX_DE='ok')
+
+
+def _t2_reg(F, tier=2, tierrule=True, **more):
+    """A registration declaring draw_exposure and a tier; tierrule.py (the repo's) placed where the host has it."""
+    F.write_reg(dict({'sha': F.canary[:7], 'reads': ['fooread', 'immobiledid'], 'draw_exposure': {'require': []},
+                      'tier': tier}, **more))
+    if tierrule:
+        shutil.copy(TIERRULE, os.path.join(F.home, 'mcai-analysis', 'tierrule.py'))
+
+
+def t_r10_tier2_needs_four_exposure_pools(CS, F):
+    """Owner policy 10-24: a tier-2 head with 2-3 pools able to expose it WAITS here (paged like any R10 wait), never
+    parks a loop in `draw` holding the lock; with 4 it launches."""
+    _t2_reg(F); F.enqueue(CS)
+    expect(CS, F, 'wait', 'R10', 'four pools', FIX_DE='ok')        # 2 exposure pools
+    expect(CS, F, 'wait', 'R10', 'four pools', FIX_DE='three')     # 3
+    expect(CS, F, 'launch', FIX_DE='four')
+
+
+def t_r10_tier2_required_pool_counts(CS, F):
+    """drawrec exempts required pools from the exposure filter, so a required pool OFF the exposure list still counts:
+    three exposure pools + required hive-b = four -> launch; a required pool already on the list adds nothing."""
+    _t2_reg(F, draw_require_pools=['hive-b']); F.enqueue(CS)
+    expect(CS, F, 'launch', FIX_DE='three')
+
+
+def t_r10_tier2_required_counts_below_two_exposure(CS, F):
+    """Codex r2: drawexposure exits 2 for a VALID read with fewer than two pools. One exposure pool (board-a) + three
+    required off the list = four -> launch; the same one pool + two required = three -> waits (tier 2's floor)."""
+    _t2_reg(F, draw_require_pools=['board-b', 'hive-a', 'hive-b']); F.enqueue(CS)
+    expect(CS, F, 'launch', FIX_DE='few')
+
+
+def t_r10_tier2_one_exposure_two_required_waits(CS, F):
+    _t2_reg(F, draw_require_pools=['board-b', 'hive-b']); F.enqueue(CS)
+    expect(CS, F, 'wait', 'R10', 'four pools', FIX_DE='few')
 
 
+def t_r10_untiered_below_two_unchanged(CS, F):
