+TIER2=$(python3 -c "import json,sys,os; sys.path.insert(0, os.path.expanduser('~/mcai-analysis')); r=json.load(open('$REG'))
+if 'tier' not in r: print('')
+else:
+    import tierrule; print('1' if tierrule.tier_of(r) == 2 else '')" 2>/dev/null) || { page error "registration $RUN declares a tier that cannot be classified (tierrule.py unreadable?)"; exit 2; }
