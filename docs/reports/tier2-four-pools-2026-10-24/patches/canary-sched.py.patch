+def tier2_of(P, reg_path):
+    """True / False, or None when the registration declares a `tier` that tierrule.py (next to the draw, in
+    ~/mcai-analysis) cannot classify. No `tier` key = False without loading anything (exactly as before)."""
+    with open(reg_path) as f:
+        reg = json.load(f)
+    if 'tier' not in reg:
+        return False
+    try:
+        import importlib.util as _u
+        spec = _u.spec_from_file_location('sched_tierrule', os.path.join(P['home'], 'mcai-analysis', 'tierrule.py'))
+        m = _u.module_from_spec(spec)
+        spec.loader.exec_module(m)
+        return m.tier_of(reg) == 2
+    except Exception:
+        return None
+
+
+T2_WAIT_MAX_H = 12.0      # the tier-2 bound, the same 12 h as the loop's T2_DRAW_MAX_H (owner policy 2026-10-24)
+
+
+def r10_wait_pages(run, h, tier2, why):
+    """W4, decided here and tested as behaviour: the pages an R10 wait of `h` hours earns -> [(level, key, msg)].
+    Every R10 wait pages a flag past STALL_H (dedup PAGE_EVERY_H), naming the floor it waits for (two pools; four for
+    tier 2). A TIER-2 wait is also bounded at T2_WAIT_MAX_H, as the loop's draw is: from then it pages an ERROR naming
+    the remedies. It is not turned into a block -- a block halts the serial queue exactly as a wait does, and the
+    policy is "waits for 4 or registers tier 3" -- so the head still launches if four pools can expose it later."""
+    out = []
+    if h > STALL_H:
+        out.append(('flag', '%s|r10wait' % run, '%s has waited %.1f h because fewer than %s pools can expose it (%s). '
+                    'The scheduler never skips the head: `queue hold`/reorder, or edit its draw_exposure'
+                    % (run, h, 'four' if tier2 else 'two', why[:200])))
+    if tier2 and h >= T2_WAIT_MAX_H:
+        out.append(('error', '%s|r10wait-t2' % run, 'tier-2 %s has waited %.1f h (the %g-h tier-2 bound) for four pools '
+                    'that can expose it, and is NOT deployed (%s). Remedy: re-register it tier 3 (a variant without '
+                    '"tier": 2, `canary-sched.py queue replace-variant %s <entry>`), or `queue hold %s <why>` and '
+                    'reorder; it launches by itself only if four pools can expose it' % (run, h, T2_WAIT_MAX_H,
+                                                                                        why[:160], run, run)))
+    return out
 
 
