+        # so it can never make drawrec time out and lose today's release with it (Claude r1 P2)
+        if time.time() - t_start > settlerule.SETTLE_BUDGET_S:
+            raise TimeoutError('settle measurement over %d s' % settlerule.SETTLE_BUDGET_S)
+
+    def s2(pool, minutes):
+        budget()
+        since = now - dt.timedelta(minutes=minutes)
+        if minutes not in cache:
