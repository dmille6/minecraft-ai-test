+            rows, bad, corrupt, _d = bagread.bot_rows(b, since, now, root=LOGROOT)
+            st[b] = bot_stats(rows, since, bad, corrupt) if (rows or bad or corrupt) else None
+            n, d = _depth_counts(b, since, now)
