+        bk, bad = cache[minutes]
+        mine = sorted(by_pool.get(pool, {}))
+        return settlerule.symmetric_build(lambda a, c, r, s0, s1, _b: tierrule.asymmetric_rows(a, c, r, s0, s1, bad),
+                                          {b: bk.get(b, {}) for b in mine},
+                                          {b: v for b, v in bk.items() if b not in mine}, mine, since, now)
