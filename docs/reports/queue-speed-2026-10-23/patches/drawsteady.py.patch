+def _incoming_reg(run, regdir=None):
+    """The INCOMING run's registration, looked up exactly as incoming_tier (and drawrec) do; None when unreadable."""
+    if not run or '/' in run:
+        return None
+    try:
+        p = os.path.join(regdir or os.path.expanduser('~/mcai-analysis/registrations'), '%s.json' % run)
+        if not os.path.exists(p):
+            p = '/tmp/registrations/%s.json' % run
+        return json.load(open(p))
+    except Exception:
+        return None
+
+
+def _depth_counts(bot, since, until, root=None):
+    """(position rows, rows below settlerule.DEPTH_Y) for one bot over [since, until), every generation by time span
+    (bagread.bot_rows' own prefilter); an unreadable file raises (the settle path then releases nothing)."""
+    import glob, gzip, re as _re, settlerule
+    lo, hi = since.strftime('%Y-%m-%dT%H:%M:%S'), until.strftime('%Y-%m-%dT%H:%M:%S')
+    ts_re = _re.compile(r'"@timestamp":\s*"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)')
+    n = deep = 0
+    for f in sorted(glob.glob(os.path.join(root or LOGROOT, bot, 'skill-*.jsonl*'))):
+        if dt.datetime.fromtimestamp(os.path.getmtime(f), dt.timezone.utc) < since:
+            continue
+        with (gzip.open(f, 'rt', errors='replace') if f.endswith('.gz') else open(f, errors='replace')) as fh:
+            for line in fh:
+                m = ts_re.search(line[:200])
+                if not m or not (lo <= m.group(1) < hi):
+                    continue
+                try:
+                    y = ((json.loads(line).get('bot') or {}).get('pos') or {}).get('y')
+                except ValueError:
+                    continue
+                if isinstance(y, (int, float)):
+                    n += 1; deep += y < settlerule.DEPTH_Y
+    return n, deep
+
