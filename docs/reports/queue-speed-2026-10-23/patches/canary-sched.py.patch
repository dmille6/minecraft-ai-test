+def r12_answer(P, st, e, v, key, full=True):
+    """R12 for an otherwise-launchable entry: the newest `drawprobe` row for this identity if younger than
+    PROBE_EVERY_MIN, else a fresh probe (st['r12_ran'] tells _tick to record it). -> (answer, eligible pools)."""
+    for r in reversed(st.get('state_rows') or []):
+        if r.get('state') == 'drawprobe' and r.get('run') == key[0] and r.get('key') == list(key):
+            w = ts(r.get('at'))
+            if w and (st['now'] - w).total_seconds() < PROBE_EVERY_MIN * 60:
+                return r.get('why') or '', r.get('elig') or []
+            break
+    if not full:
+        return '', []
+    why, drawn, elig = draw_probe(P, e['run'], v['registration'])
+    st['r12_ran'] = {'state': 'drawprobe', 'run': e['run'], 'key': list(key), 'why': why, 'drawn': drawn, 'elig': elig}
+    return why, elig
