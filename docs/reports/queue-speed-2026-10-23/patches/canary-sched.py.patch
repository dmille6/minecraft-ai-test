+def lookahead_inputs(st, head, lib):
+    """PURE given st. -> (Head, [Entry behind the head]) for lookahead.decide. A behind-entry's own blockers are the
+    scheduler's: entry_state, its hold, every `after` not closed, a variant keyed by the full base; H3-H6 are added by
+    the caller for the ONE candidate it then checks in full (variant_checks is impure)."""
+    rows = st.get('state_rows') or []
+    since = lib.draw_blocked_since(rows, head.get('run'), st['now'])
+    hd = lib.Head(run=head.get('run'), hard_blockers=[], draw_blocked_since=ts(since) if since else None,
+                  skipped_last=lib.skipped_last(rows, head.get('run')))
+    ents = (st.get('queue') or {}).get('entries') or []
+    idx = next((i for i, x in enumerate(ents) if x.get('run') == head.get('run')), len(ents))
+    out = []
+    for e in ents[idx + 1:]:
+        es = entry_state(e, st)
+        nb = ts(e.get('not_before')) if e.get('not_before') else None
+        other = ['not before %s' % e['not_before']] if (e.get('not_before') and (nb is None or nb > st['now'])) else []
+        klass = e.get('class') or ''
+        if st.get('next_slot') and klass != 'underground-safety':      # H5, as head_blockers
+            other.append('H5 NEXT-SLOT')
+        if klass == 'bag-fix' and not st.get('drawrec_k4'):              # H6, as head_blockers
+            other.append('H6 TARGET_K')
+        out.append(lib.Entry(run=e.get('run'), state=es, hold=bool(e.get('hold')),
+                             after_unmet=[a for a in e.get('after') or [] if journal_status(a, st) != 'closed'],
+                             has_variant=bool(st.get('base_full') and st['base_full'] in (e.get('variants') or {})),
+                             klass=e.get('class') or '', other_blockers=other))
+    return hd, out
+
