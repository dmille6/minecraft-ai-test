+# ------------------------------------------------------------------------------- design 2: R12 + the lookahead --
+def parse_probe(txt, min_k):
+    """PURE. drawrec.sh's output -> ('' | 'WAIT ...' | 'probe failed ...', the pools it would draw, the pools eligible).
+    The DRAW line is drawrec's own (the loop greps the same line)."""
+    m = DRAW_LINE.search(txt or '')
+    if not m:
+        return 'drawrec.sh gave no DRAW line: %s' % ' '.join((txt or '').split())[-200:], [], []
+    drawn = POOL_TOKEN.findall(m.group(2)) if m.group(2).startswith('[') else []
+    el = next((l for l in (txt or '').splitlines() if l.startswith('eligible ')), '')
+    elig = sorted(set(POOL_TOKEN.findall(el.split('|')[0])))
+    if len(drawn) < min_k:
+        return 'WAIT the draw would take %d pool(s) (< %d): %s' % (len(drawn), min_k, m.group(0)[:160]), drawn, elig
+    return '', drawn, elig
 
 
+def probe_min_k(reg):
+    """PURE. The fewest pools the loop deploys: a bag fix 3 (its 4-pool target falls to 3 after an hour of draw-short,
+    in the loop), a draw_k cap its cap, anything else drawrec's MIN_K 2."""
+    if (reg or {}).get('class') == 'bag-fix':
+        return 3
+    dk = (reg or {}).get('draw_k')
+    return dk if isinstance(dk, int) and 1 <= dk < 2 else 2
+
+
+def draw_probe(P, run, reg_path, reserve=()):
+    """R12 (impure): drawrec.sh for `run`, read-only, against a temp registrations dir holding ONLY the QUEUED
+    registration (DRAW_REGDIR, as R10 does with --registrations: a not-yet-launched run has nothing staged yet), with
+    DRAW_RESERVE when given. -> parse_probe(...). drawrec writes only /tmp/drawrec.txt, which the loop rewrites
+    before each of its own draws; it is never run while a loop is alive (the slot is free when R12 is asked)."""
+    d = tempfile.mkdtemp(prefix='sched-r12-')
+    try:
+        with open(reg_path) as f:
+            reg = json.load(f)
+        shutil.copy(reg_path, os.path.join(d, '%s.json' % run))
+        env = dict(os.environ)
+        env.pop('DRAW_RESERVE', None)                 # a probe of the HEAD never inherits a reservation
+        env['DRAW_REGDIR'] = d
+        if reserve:
+            env['DRAW_RESERVE'] = ','.join(sorted(reserve))
+        r = subprocess.run(['bash', P['drawrec'], run], capture_output=True, text=True, timeout=1200, env=env)
+        return parse_probe(r.stdout + r.stderr, probe_min_k(reg))
+    except Exception as x:
+        return 'probe failed: %s' % x, [], []
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
+
