+def load_lookahead(P):
+    """lookahead.py, next to this file on the host (~/lookahead.py) or SCHED_LOOKAHEAD_LIB (a fixture); absent or
+    unloadable = no lookahead at all (today's behaviour)."""
+    try:
+        import importlib.util as _u
+        spec = _u.spec_from_file_location('sched_lookahead', os.path.join(P['lookahead_lib'], 'lookahead.py'))
+        m = _u.module_from_spec(spec)
+        spec.loader.exec_module(m)
+        return m
+    except Exception:
+        return None
