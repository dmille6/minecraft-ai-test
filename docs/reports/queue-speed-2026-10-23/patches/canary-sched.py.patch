+def try_lookahead(P, st, head, stamp, no_act):
+    """Design 2. True when a lookahead launch was made (or, --no-act, would be). Every failure is printed and returns
+    False: the head keeps waiting exactly as today."""
+    L = load_lookahead(P)
+    if L is None:
+        print('%s LOOKAHEAD off: lookahead.py not loadable' % stamp); return False
+    busy, block = slot_blockers(st)
+    hd, behind = lookahead_inputs(st, head, L)
+    dec = L.decide(hd, behind, st['now'], slot_free=not (busy or block), death_hold=bool(st.get('death_hold')),
+                   next_slot=bool(st.get('next_slot')))
+    if dec[0] != 'lookahead':
+        print('%s LOOKAHEAD no: %s' % (stamp, dec[1])); return False
+    e2 = next(x for x in st['queue']['entries'] if x.get('run') == dec[1])
+    v2 = e2['variants'][st['base_full']]
+    st2 = dict(st)
+    st2['variant_checks'], st2['stage'] = variant_checks(P, e2, v2, st['base_full'], st)
+    hb = head_blockers(e2, st2)
+    if hb or entry_state(e2, st2) != 'ready':
+        print('%s LOOKAHEAD no: candidate %s is not launchable: %s' % (stamp, e2['run'], '; '.join(r for _c, r, _w in hb)))
+        return False
+    r10 = r10_check(P, e2, v2)
+    if r10:
+        print('%s LOOKAHEAD no: candidate %s R10: %s' % (stamp, e2['run'], r10)); return False
+    reserve = sorted(set(R10_ELIG.get(head['run']) or []) | set(st.get('r12_elig') or []))
+    why, drawn, _el = draw_probe(P, e2['run'], v2['registration'], reserve)
+    if why:
+        print('%s LOOKAHEAD no: candidate %s R12 with the head\'s pools %s reserved: %s' % (stamp, e2['run'], reserve, why))
+        return False
+    # the checks above took minutes: the slot, the head and the candidate are re-read before anything is touched
+    st3 = gather(P, full=False)
+    b3, k3 = slot_blockers(st3)
+    if b3 or k3 or (head_entry(st3) or {}).get('run') != head['run'] or st3.get('base_full') != st['base_full'] \
+            or entry_state(e2, st3) != 'ready':
+        print('%s LOOKAHEAD deferred: the slot, head or base changed during the checks' % stamp); return False
+    print('%s LAUNCH %s AHEAD OF %s (draw-blocked since %s; reserve %s; variant on %s, canary %s)%s' % (
+        stamp, e2['run'], head['run'], hd.draw_blocked_since, reserve, st['base_full'][:7],
+        str(v2.get('canary_sha'))[:7], ' -- NO-ACT' if no_act else ''))
+    if not no_act:
+        st3['stage'] = st2['stage']
+        launch(P, st3, e2, v2, lookahead_past=head['run'], reserve=reserve)
+        page(P, st3, 'flag', '%s|lookahead' % e2['run'], 'LOOKAHEAD: launched %s ahead of %s (draw-blocked since %s); %s '
+             'goes first at the next opening and is never skipped twice in a row' % (e2['run'], head['run'],
+                                                                                   hd.draw_blocked_since, head['run']))
+    return True
+
