+# ------------------------------------------------------------------- design 2 (queue-speed-1023): R12 + lookahead --
+def two_entries(CS, F, after=None, nb=None, hold=None):
+    """foo-01 (the head) and bar-01 behind it, both on the fleet base, the same canary sha."""
+    reg2 = os.path.join(F.home, 'mcai-analysis', 'bar-01.json')
+    json.dump({'sha': F.canary[:7], 'reads': ['fooread', 'immobiledid'], 'read_minutes': [180, 360]}, open(reg2, 'w'))
+    with Env(F.env()):
+        e1 = json.loads(json.dumps(F.entry))
+        e2 = {'run': 'bar-01', 'class': '', 'after': after or [], 'not_before': None, 'hold': hold,
+              'variants': {F.base: {'registration': reg2, 'approved': 'test fixture'}}}
+        if nb:
+            e1['not_before'] = nb
+        for e in (e1, e2):
+            bad = CS.validate_entry(CS.paths(), e, [])
+            assert not bad, bad
+        json.dump({'version': 1, 'entries': [e1, e2]}, open(F.queue, 'w'))
+    return e1, e2
+
+
+def head_reg(F):
+    """The queued head's registration sha256 on the fixture base (drawwait rows carry it since round 3)."""
+    q = json.load(open(F.queue))
+    return q['entries'][0]['variants'][F.base]['registration_sha256']
+
