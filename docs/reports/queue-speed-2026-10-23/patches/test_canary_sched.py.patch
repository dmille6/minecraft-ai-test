+    assert w == '' and d == ['board-a', 'hive-b'] and e == ['board-a'], (w, d, e)
+    w, d, e = CS.parse_probe(INS + 'DRAW (none, owner C): NONE (fewer than 2 eligible)', 2)
+    assert w.startswith('WAIT') and d == [], w
+    w, d, e = CS.parse_probe(INS + "DRAW (3 pools = 15 bots, owner C): ['a-a', 'b-b', 'c-c']", 3)
+    assert w == '', w
+    w, _d, _e = CS.parse_probe('Traceback: boom', 2)
+    assert w and not w.startswith('WAIT'), 'no DRAW line must BLOCK, not wait: %s' % w
+    assert CS.probe_min_k({'class': 'bag-fix'}) == 3 and CS.probe_min_k({'draw_k': 1}) == 1 and CS.probe_min_k({}) == 2
+    # an empty exposure table (a /tmp read missing) reads as "fewer than 2 eligible": it must BLOCK (Claude r1 P1)
+    w, _d, _e = CS.parse_probe('instruments: band rows 11, exposure rows 0\nDRAW (none, owner C): NONE (fewer than 2 eligible)', 2)
+    assert w and not w.startswith('WAIT') and 'instruments' in w, w
+    w, _d, _e = CS.parse_probe('DRAW (none, owner C): NONE (fewer than 2 eligible)', 2)
+    assert w and not w.startswith('WAIT'), 'no instruments line must BLOCK: %s' % w
