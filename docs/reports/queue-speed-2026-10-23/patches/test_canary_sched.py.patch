+# ------------------------------------------------------------------- design 2 (queue-speed-1023): R12 + lookahead --
+def two_entries(CS, F, after=None, nb=None, hold=None):
+    """foo-01 (the head) and bar-01 behind it, both on the fleet base, the same canary sha."""
+    reg2 = os.path.join(F.home, 'mcai-analysis', 'bar-01.json')
+    json.dump({'sha': F.canary[:7], 'reads': ['fooread', 'immobiledid'], 'read_minutes': [180, 360]}, open(reg2, 'w'))
+    with Env(F.env()):
+        e1 = json.loads(json.dumps(F.entry))
+        e2 = {'run': 'bar-01', 'class': '', 'after': after or [], 'not_before': None, 'hold': hold,
+              'variants': {F.base: {'registration': reg2, 'approved': 'test fixture'}}}
+        if nb:
+            e1['not_before'] = nb
+        for e in (e1, e2):
+            bad = CS.validate_entry(CS.paths(), e, [])
+            assert not bad, bad
+        json.dump({'version': 1, 'entries': [e1, e2]}, open(F.queue, 'w'))
+    return e1, e2
+
+
+def sched_rows(F):
+    p = os.path.join(F.home, 'digest', 'sched-state.jsonl')
+    return [json.loads(l) for l in open(p)] if os.path.exists(p) else []
+
+
+def t_r12_parse_probe(CS, F):
+    w, d, e = CS.parse_probe("eligible [('board-a', 'x', 1.0, (1, 1, 0))] | t\nDRAW (2 pools = 10 bots, owner C): ['board-a', 'hive-b']", 2)
+    assert w == '' and d == ['board-a', 'hive-b'] and e == ['board-a'], (w, d, e)
+    w, d, e = CS.parse_probe('DRAW (none, owner C): NONE (fewer than 2 eligible)', 2)
+    assert w.startswith('WAIT') and d == [], w
+    w, d, e = CS.parse_probe("DRAW (3 pools = 15 bots, owner C): ['a-a', 'b-b', 'c-c']", 3)
+    assert w == '', w
+    w, _d, _e = CS.parse_probe('Traceback: boom', 2)
+    assert w and not w.startswith('WAIT'), 'no DRAW line must BLOCK, not wait: %s' % w
+    assert CS.probe_min_k({'class': 'bag-fix'}) == 3 and CS.probe_min_k({'draw_k': 1}) == 1 and CS.probe_min_k({}) == 2
+
+
+def t_r12_draw_none_waits(CS, F):
+    F.enqueue(CS)
+    expect(CS, F, 'wait', 'R12', FIX_DRAW_NONE='foo-01')
+
+
+def t_r12_probe_uses_the_queued_registration(CS, F):
+    F.enqueue(CS)
+    log = os.path.join(F.d, 'draw.log')
+    expect(CS, F, 'launch', FIX_DRAW_LOG=log)
+    assert 'foo-01 reserve= regdir=ok' in open(log).read(), open(log).read()
+
+
+def t_r12_cached_within_probe_every(CS, F):
+    F.enqueue(CS)
+    with Env(F.env(FIX_DRAW_NONE='foo-01')):
+        assert CS.tick(CS.paths()) == 0                 # probes once and records it
+    probes = [r for r in sched_rows(F) if r.get('state') == 'drawprobe']
+    assert len(probes) == 1 and probes[0]['why'].startswith('WAIT'), probes
+    # 10 min later the pools are back, but the cached probe still answers (no second drawrec run within 20 min)
+    expect(CS, F, 'wait', 'R12', SCHED_FAKE_NOW=Z(NOW + dt.timedelta(minutes=10)))
+    for b in BOTS:                                       # keep S5 fresh at +21 min
+        F.log(b, NOW + dt.timedelta(minutes=20), F.base[:7] + '+abc123')
+    expect(CS, F, 'launch', SCHED_FAKE_NOW=Z(NOW + dt.timedelta(minutes=21)))
+
+
+def t_la_launches_behind_a_draw_blocked_head(CS, F):
+    two_entries(CS, F)
+    F.state({'state': 'drawwait', 'run': 'foo-01', 'at': Z(NOW - dt.timedelta(minutes=40))})
+    log = os.path.join(F.d, 'draw.log')
+    with Env(F.env(FIX_DRAW_NONE='foo-01', FIX_LOOP='ok', FIX_DRAW_LOG=log)):
+        assert CS.tick(CS.paths()) == 0
+    la = [r for r in sched_rows(F) if r.get('state') == 'launching']
+    assert la and la[-1]['run'] == 'bar-01' and la[-1].get('lookahead_past') == 'foo-01', la
+    # the candidate's probe carried the head's pools as a reserve (the head's R12 eligible set)
+    assert 'bar-01 reserve=board-a regdir=ok' in open(log).read(), open(log).read()
+
+
+def t_la_waits_30_min(CS, F):
+    two_entries(CS, F)
+    F.state({'state': 'drawwait', 'run': 'foo-01', 'at': Z(NOW - dt.timedelta(minutes=20))})
+    with Env(F.env(FIX_DRAW_NONE='foo-01', FIX_LOOP='ok')):
+        assert CS.tick(CS.paths()) == 0
+    assert not [r for r in sched_rows(F) if r.get('state') == 'launching'], 'launched before 30 min'
+
+
+def t_la_first_drawwait_row_starts_the_clock(CS, F):
+    two_entries(CS, F)
+    with Env(F.env(FIX_DRAW_NONE='foo-01', FIX_LOOP='ok')):
+        assert CS.tick(CS.paths()) == 0
+    rows = sched_rows(F)
+    assert [r for r in rows if r.get('state') == 'drawwait' and r.get('run') == 'foo-01'], rows
+    assert not [r for r in rows if r.get('state') == 'launching'], 'launched on the first blocked tick'
+
