+def t_la_episode_ends_on_a_non_draw_reason(CS, F):
+    two_entries(CS, F, nb=Z(NOW + dt.timedelta(hours=2)))
+    F.state({'state': 'drawwait', 'run': 'foo-01', 'at': Z(NOW - dt.timedelta(minutes=40))})
+    with Env(F.env(FIX_LOOP='ok')):
+        assert CS.tick(CS.paths()) == 0
+    rows = [r for r in sched_rows(F) if r.get('run') == 'foo-01' and r.get('state') in ('drawwait', 'drawclear')]
