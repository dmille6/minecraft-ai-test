+def t_la_head_goes_first_after(CS, F):
+    """Once the head can draw, it launches (it is still the head); the lookahead never re-orders the queue."""
+    two_entries(CS, F)
+    F.state({'state': 'drawwait', 'run': 'foo-01', 'at': Z(NOW - dt.timedelta(minutes=300))})
+    F.state({'state': 'launching', 'run': 'zzz-01', 't0': Z(NOW - dt.timedelta(minutes=200)), 'lookahead_past': 'foo-01',
+             'at': Z(NOW - dt.timedelta(minutes=200))})
+    d, _st = expect(CS, F, 'launch')
+    assert d[1]['run'] == 'foo-01', d[1]['run']
+
+
+def t_la_candidate_must_pass_h3(CS, F):
+    """The candidate gets the head's FULL checks: its registration edited after queueing (H3) stops it."""
+    _e1, e2 = two_entries(CS, F)
+    F.state({'state': 'drawwait', 'run': 'foo-01', 'at': Z(NOW - dt.timedelta(minutes=40))})
+    reg2 = e2['variants'][F.base]['registration']
+    r = json.load(open(reg2)); r['notes'] = 'edited after queueing'; json.dump(r, open(reg2, 'w'))
+    with Env(F.env(FIX_DRAW_NONE='foo-01', FIX_LOOP='ok')):
+        assert CS.tick(CS.paths()) == 0
+    assert not [r for r in sched_rows(F) if r.get('state') == 'launching'], 'launched a candidate failing H3'
