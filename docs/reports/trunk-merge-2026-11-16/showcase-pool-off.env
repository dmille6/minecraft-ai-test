IRONCHAIN_TUNNEL=0

# --- buildwait-01 (row 17): off = a build visit declares no waiting window to the stuck reflex.
# buildbot.mjs:56  trimmed, lower-cased, one of 0|off|false|no
BUILDWAIT=0

# --- dirtrung-01 (row 18): off = the dirt rung is met by 16 dirt only.
# milestones.mjs:58  `String(env?.DIRTRUNG_EARTH ?? '1').trim() !== '0'`  -- ONLY `0`
DIRTRUNG_EARTH=0

# --- gkstay-01 (row 19): off = a keeper is not rested or handed on for an underground idle batch.
# idlework.mjs:188  trimmed, lower-cased, one of 0|off|false|no
GKSTAY=0
