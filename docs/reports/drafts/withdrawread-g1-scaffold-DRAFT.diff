+# G1 AMENDMENT (withdraw2-02, 10-10): withdraw2-01 reverted at +180 on 3 G1 "losses" that were the PATHFINDER's own
+# scaffolding on the walk to the chest/table (1 dirt, 1 dirt, 1 cobblestone; a _path_reset place_error inside the order
+# window). mineflayer-pathfinder bridges with scafoldingBlocks (dirt, cobblestone; scaffold.mjs) and this codebase adds
+# the stone family. A fall of a SCAFFOLD name of at most SCAFFOLD_EXCUSE blocks in one order is movement, not the
+# transfer: reported as scaffold_spent, never counted in G1. A larger fall, or any other name, is still a breach.
+SCAFFOLD_NAMES = {'dirt', 'cobblestone', 'cobbled_deepslate', 'stone', 'andesite', 'diorite', 'granite', 'deepslate',
+                  'netherrack', 'tuff'}
+SCAFFOLD_EXCUSE = 3
+
+
+def split_scaffold(losses):
+    """[(name, delta)] -> (breaches, excused): scaffold names falling by <= SCAFFOLD_EXCUSE in total are excused."""
+    if losses is None:
+        return None, []
+    sc = [(n, d) for n, d in losses if n in SCAFFOLD_NAMES]
+    if sc and -sum(d for _, d in sc) <= SCAFFOLD_EXCUSE:
+        return [(n, d) for n, d in losses if n not in SCAFFOLD_NAMES], sc
+    return losses, []
+
