#!/usr/bin/env python3
"""mcai-brain-subset -- KEEP ON A FIXED SUBSET (brain-01). /usr/local/sbin, run as root by the canary loop's keep-subset
phase or by the operator. STAGED 2026-10-12: NOT INSTALLED.

    mcai-brain-subset apply  --run R --pools P,Q --env "K=V K=V"
    mcai-brain-subset remove --pools P,Q
    mcai-brain-subset status

THE RECORD /srv/mcbots/brain-subset.json {run, pools, bots, env, state, since} is what drawrec (never draws these pools)
and verdict.py / every read (never uses these bots as control) read. It is written FIRST and removed LAST, so the
exclusion covers every moment the env might be live:
  apply:  record state=applying (exclusion on) -> marked env block in each bot's harness env file (backup first) ->
          restart 12 s apart -> verify EVERY bot's live process carries EXACTLY K=V -> state=live. A failure exits
          non-zero and leaves state=applying: still excluded, and `apply` again with the same run/pools/env RESUMES.
  remove: state=removing -> strip the block -> restart -> verify, POSITIVELY, that every bot's process is readable and
          carries none of the keys -> only then drop the pools from the record. A failure leaves them excluded.
Another `apply` while a record exists for a different run, pools or env is REFUSED (one subset at a time).
The env block is `# >>> brain-subset ...` .. `# <<< brain-subset`; deploy-fleet.sh's CODE_VERSION/RUN_ID edits leave it
alone. generate-roster.py rewrites env files: run `remove` before regenerating and `apply` after.
Overrides (tests only): MCAI_HARNESS, MCAI_SUBSET_REC, MCAI_SUBSET_TEST=1 (no restarts; the env FILE stands in for the
process environment).
"""
import json, os, re, shutil, subprocess, sys, time
H = os.environ.get('MCAI_HARNESS', '/srv/mcbots/harness'); REC = os.environ.get('MCAI_SUBSET_REC', '/srv/mcbots/brain-subset.json')
TEST = bool(os.environ.get('MCAI_SUBSET_TEST'))
BEGIN, END = '# >>> brain-subset', '# <<< brain-subset'
KV = re.compile(r'^[A-Z_][A-Z0-9_]*=\S+$')


def die(msg, code=2):
    print(msg, file=sys.stderr); sys.exit(code)


def bots_of(pools):
    out = []
    for p in pools:
        out += sorted(f[:-4] for f in os.listdir(os.path.join(H, 'env')) if f.startswith(p + '-') and f.endswith('.env'))
    return out


def read_rec():
    return json.load(open(REC)) if os.path.exists(REC) else None


def write_rec(r):
    tmp = REC + '.tmp'; json.dump(r, open(tmp, 'w'), indent=1); os.replace(tmp, REC)


def strip_block(text):
    out, skip = [], False
    for l in text.splitlines(True):
        if l.startswith(BEGIN): skip = True; continue
        if skip and l.startswith(END): skip = False; continue
        if not skip: out.append(l)
    return ''.join(out)


def live_env(bot):
    """The bot's PROCESS environment as {K: V}, or None when it cannot be read (no pid, unreadable): never 'absent'."""
    if TEST:
        try:
            return dict(l.rstrip('\n').split('=', 1) for l in open(os.path.join(H, 'env', bot + '.env')) if '=' in l and not l.startswith('#'))
        except OSError:
            return None
    pid = subprocess.run(['systemctl', 'show', '-p', 'MainPID', '--value', 'mcbot@%s.service' % bot], capture_output=True, text=True).stdout.strip()
    if not pid or pid == '0':
        return None
    try:
        raw = open('/proc/%s/environ' % pid, 'rb').read().split(b'\0')
    except OSError:
        return None
    return dict(x.decode(errors='replace').split('=', 1) for x in raw if b'=' in x)


def restart(bots):
    if TEST:
        return
    for i, b in enumerate(bots):
        if i:
            time.sleep(12)
        subprocess.run(['systemctl', 'restart', 'mcbot@%s.service' % b], check=False)
    time.sleep(20)


def apply(run, pools, env):
    if not env or not all(KV.match(kv) for kv in env):
        die('apply: --env must be KEY=VALUE entries without spaces')
    if any(kv.split('=', 1)[0] in ('CODE_VERSION', 'RUN_ID') for kv in env):
        die('apply: may not set CODE_VERSION or RUN_ID')
    bots = bots_of(pools)
    if not bots:
        die('apply: no env files for pools %s' % pools)
    r = read_rec()
    if r and (r.get('run') != run or sorted(r.get('pools', [])) != sorted(pools) or r.get('env') != env):
        die('apply: a different subset is recorded (%s %s); remove it first' % (r.get('run'), r.get('pools')))
    ts = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
    write_rec({'run': run, 'pools': pools, 'bots': bots, 'env': env, 'state': 'applying', 'since': (r or {}).get('since', ts)})
    for b in bots:
        f = os.path.join(H, 'env', b + '.env'); shutil.copy2(f, f + '.bak-brainsubset-' + ts)
        text = strip_block(open(f).read())
        if not text.endswith('\n'): text += '\n'
        open(f, 'w').write(text + '%s %s %s (do not edit; mcai-brain-subset)\n%s\n%s\n' % (BEGIN, run, ts, '\n'.join(env), END))
    restart(bots)
    want = dict(kv.split('=', 1) for kv in env)
    bad = []
    for b in bots:
        e = live_env(b)
        if e is None: bad.append('%s:unreadable' % b); continue
        bad += ['%s:%s' % (b, k) for k, v in want.items() if e.get(k) != v]
    if bad:
        die('SUBSET NOT LIVE (state stays applying; still excluded; re-run apply to resume): ' + ' '.join(bad), 4)
    r = read_rec(); r['state'] = 'live'; write_rec(r)
    print('SUBSET LIVE: %d bot(s) in %s carry exactly %s' % (len(bots), ','.join(pools), ' '.join(env)))


def remove(pools):
    r = read_rec()
    if not r:
        die('remove: no subset recorded')
    keys = [kv.split('=', 1)[0] for kv in r.get('env', [])]
    bots = bots_of(pools)
    r['state'] = 'removing'; write_rec(r)
    ts = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
    for b in bots:
        f = os.path.join(H, 'env', b + '.env'); shutil.copy2(f, f + '.bak-brainsubset-' + ts)
        text = strip_block(open(f).read())          # READ, then write (Codex r2: open(f, 'w') first truncated it)
        open(f, 'w').write(text)
    restart(bots)
    bad = []
    for b in bots:
        e = live_env(b)
        if e is None: bad.append('%s:unreadable' % b); continue
        bad += ['%s:%s' % (b, k) for k in keys if k in e]
    if bad:
        die('ENV STILL LIVE or UNPROVEN (state stays removing; still excluded): ' + ' '.join(bad), 4)
    r['pools'] = [p for p in r['pools'] if p not in pools]
    r['bots'] = [b for b in r['bots'] if b not in bots]
    if r['pools']:
        write_rec(r)
    else:
        os.remove(REC)
    print('SUBSET REMOVED from %s (verified on %d bot(s))' % (','.join(pools), len(bots)))


def status():
    r = read_rec()
    if not r:
        print('no brain subset'); return
    print(json.dumps(r, indent=1))
    want = dict(kv.split('=', 1) for kv in r.get('env', []))
    for b in r.get('bots', []):
        e = live_env(b)
        print('  %s %s' % (b, 'UNREADABLE' if e is None else ('live' if all(e.get(k) == v for k, v in want.items()) else 'NOT LIVE')))


if __name__ == '__main__':
    a = sys.argv[1:]; cmd = a[0] if a else 'status'
    opt = {a[i]: a[i + 1] for i in range(1, len(a) - 1, 2)}
    if cmd == 'apply':
        apply(opt.get('--run') or die('apply needs --run'), [p for p in (opt.get('--pools') or '').split(',') if p], (opt.get('--env') or '').split())
    elif cmd == 'remove':
        remove([p for p in (opt.get('--pools') or '').split(',') if p])
    elif cmd == 'status':
        status()
    else:
        die('usage: mcai-brain-subset apply|remove|status')
