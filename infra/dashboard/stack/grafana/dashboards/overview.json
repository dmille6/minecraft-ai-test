  {
   "id": 9,
   "type": "timeseries",
   "title": "Showcase: blocks placed per hour",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 16,
    "h": 9
   },
   "description": "Blocks placed per hour, from _build op=place rows: on town buildings vs clean-up fills. Until 11-18 every placed block went to clean-up (bags full; idle visits sent only to clean-up).",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "elasticsearch",
      "uid": "mcai-es"
     },
     "query": "_index:.ds-mcai-skill-showcase* AND (skill.name:_build AND skill.detail:\"op=place\" AND NOT skill.detail:\"project=tidy\" AND NOT skill.detail:\"project=yard\")",
     "alias": "on buildings",
     "timeField": "@timestamp",
     "metrics": [
      {
       "type": "count",
       "id": "1"
      }
     ],
     "bucketAggs": [
      {
       "type": "date_histogram",
       "id": "2",
       "field": "@timestamp",
       "settings": {
        "interval": "1h",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ]
    },
    {
     "refId": "B",
     "datasource": {
      "type": "elasticsearch",
      "uid": "mcai-es"
     },
     "query": "_index:.ds-mcai-skill-showcase* AND (skill.name:_build AND skill.detail:\"op=place\" AND (skill.detail:\"project=tidy\" OR skill.detail:\"project=yard\"))",
     "alias": "clean-up (tidy, yard)",
     "timeField": "@timestamp",
     "metrics": [
      {
       "type": "count",
       "id": "1"
      }
     ],
     "bucketAggs": [
      {
       "type": "date_histogram",
       "id": "2",
       "field": "@timestamp",
       "settings": {
        "interval": "1h",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ]
    }
   ],
   "datasource": {
    "type": "elasticsearch",
    "uid": "mcai-es"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "gradientMode": "none",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "on buildings"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "clean-up (tidy, yard)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
