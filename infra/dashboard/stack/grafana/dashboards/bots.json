   },
   "description": "Successful / all non-internal skill rows, last 24 h. Neutral colour: no baseline has been measured to judge it against.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "elasticsearch",
      "uid": "mcai-es"
     },
     "query": "NOT skill.name:_* AND skill.status:success",
     "alias": "",
     "timeField": "@timestamp",
     "metrics": [
      {
       "type": "count",
       "id": "1"
      }
     ],
     "bucketAggs": [
      {
       "type": "date_histogram",
       "id": "2",
       "field": "@timestamp",
       "settings": {
        "interval": "1h",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ],
     "hide": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "elasticsearch",
      "uid": "mcai-es"
     },
     "query": "NOT skill.name:_*",
     "alias": "",
     "timeField": "@timestamp",
     "metrics": [
      {
       "type": "count",
       "id": "1"
      }
     ],
     "bucketAggs": [
      {
       "type": "date_histogram",
       "id": "2",
       "field": "@timestamp",
       "settings": {
        "interval": "1h",
        "min_doc_count": "0",
        "trimEdges": "0"
       }
      }
     ],
     "hide": true
    },
    {
     "refId": "SA",
     "datasource": {
      "type": "__expr__",
      "uid": "__expr__"
     },
     "type": "reduce",
     "expression": "$A",
     "reducer": "sum",
     "settings": {
      "mode": "replaceNN",
      "replaceWithValue": 0
     },
     "hide": true
    },
    {
     "refId": "SB",
     "datasource": {
      "type": "__expr__",
      "uid": "__expr__"
     },
     "type": "reduce",
     "expression": "$B",
     "reducer": "sum",
     "settings": {
      "mode": "replaceNN",
      "replaceWithValue": 0
     },
     "hide": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "__expr__",
      "uid": "__expr__"
     },
     "type": "math",
     "expression": "$SA / $SB * 100"
    }
   ],
   "datasource": {
    "type": "elasticsearch",
    "uid": "mcai-es"
   },
