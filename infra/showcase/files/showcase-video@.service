[Unit]
Description=SHOWCASE timelapse video (%i: daily | weekly | history | monthly)

[Service]
Type=oneshot
User=mike
Environment=TL_ROOT=/srv/showcase/timelapse
ExecStart=/usr/bin/python3 /srv/showcase/bin/tl_video.py %i
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
# tlpolish-1106: daily/history run motion interpolation all night against tl_video's own deadline (23:45 UTC); weight
# 1 (was 20) so the 15-min capture (weight 20), Paper and the bots always win the CPU first
CPUWeight=1
# a backstop only: tl_video ends smoothing by 23:45 and falls back to the dissolve (was 3h)
TimeoutStartSec=23h55min
