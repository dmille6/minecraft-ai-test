# Sandbox bot env: a real bot from this checkout against the SANDBOX Paper server on the
# worlds host (port 25599). Never an mcbot@ unit on 10.0.0.31; never /var/log/mcai.
BOT_NAME=sandbox-Ore
BOT_ROLE=gatherer
EXP_INSTANCE=sandbox
EXP_BLOCK=sandbox
EXP_ARM=sandbox
MEMORY_SCOPE=checkpoint
MEMORY_POOL=sandbox
MINECRAFT_HOST=10.0.0.30
MINECRAFT_PORT=25599
MINECRAFT_VERSION=1.21.8
MINECRAFT_AUTH=offline
WORLD_BORDER_RADIUS=1950
BOARD_RADIUS=8
REFLEX_TICK_MS=500
SKILL_TIMEOUT_MS=180000
MAX_CONSECUTIVE_FAILURES=3
EAT_BELOW_FOOD=16
FLEE_BELOW_HEALTH=8
STUCK_SECONDS=35
# The model is OFF: the rescue path is reflex + deterministic skills, and the sandbox
# must not load either inference box. The OLLAMA_* values are required by config but unused.
LLM_ENABLED=true
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://127.0.0.1:11499
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=45000
LLM_PROMPT_TOKEN_BUDGET=3000
LLM_DECISION_COOLDOWN_MS=8000
RECONNECT_DELAY_MS=8000
RECONNECT_MAX_DELAY_MS=120000
ENABLE_AGENT_CODE_EXECUTION=false
VIEWER_ENABLED=false
VIEWER_FIRST_PERSON=false
VIEWER_PORT=0
LOG_LEVEL=debug
CODE_VERSION=sandbox
RUN_ID=sandbox
# HOME/BOARD are overwritten per scenario by the loader (fixture origin)
HOME_X=300
HOME_Y=41
HOME_Z=300
BOARD_X=300
BOARD_Y=41
BOARD_Z=300
LOG_DIR=./sandbox/log/sandbox-Ore
STATE_DIR=./sandbox/state/sandbox-Ore
OLLAMA_BASE_URLS=http://127.0.0.1:11499
