{
  "name": "mcai-harness",
  "version": "0.1.0",
  "description": "Deterministic mineflayer harness for the minecraft-ai testbed. Pass 1: no LLM.",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "lint": "eslint src/*.mjs",
    "lint:movement": "node scripts/check-movement-writers.mjs",
    "check": "npm run lint && npm run lint:movement"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-plugin-no-floating-promise": "^2.0.0"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-collectblock": "1.5.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "vec3": "^0.1.10"
  }
}
