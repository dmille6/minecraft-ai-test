# Copy to .env on the VM and fill in. NEVER commit the real .env -- this repo is public.

# --- Minecraft -------------------------------------------------------------
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
# Pinned, not auto-detected. mineflayer's protocol layer stops at 1.21.11, and
# auto-detect would fail silently and confusingly after a server upgrade.
MINECRAFT_VERSION=1.21.11
MINECRAFT_AUTH=offline

# --- Identity --------------------------------------------------------------
# This exact string must be on the server whitelist, with matching case.
# Offline-mode UUIDs are derived from the name bytes, so "Scout01" and
# "scout01" are different players.
BOT_NAME=Scout01
BOT_ROLE=scout

# --- World bounds ----------------------------------------------------------
# Skills refuse destinations beyond this, so a goal can never chase the bot
# into ungenerated chunks. Keep in sync with the server's worldborder.
WORLD_BORDER_RADIUS=1950
HOME_X=0
HOME_Y=70
HOME_Z=0

# --- Reflex layer ----------------------------------------------------------
REFLEX_TICK_MS=500
EAT_BELOW_FOOD=16
FLEE_BELOW_HEALTH=8
STUCK_SECONDS=20

# --- Skill watchdogs -------------------------------------------------------
SKILL_TIMEOUT_MS=180000
MAX_CONSECUTIVE_FAILURES=3

# --- Logging ---------------------------------------------------------------
# Filebeat tails this directory; the JSONL files are the source of truth.
LOG_DIR=/srv/minecraft/bots/logs
LOG_LEVEL=info
# Leave unset to auto-generate per process start. Set explicitly to group a
# planned experiment across restarts.
# RUN_ID=soak-001

RECONNECT_DELAY_MS=8000
RECONNECT_MAX_DELAY_MS=120000

# --- Cognitive layer -------------------------------------------------------
# Set true to let the model drive. False = chat commands only.
LLM_ENABLED=false
OLLAMA_BASE_URL=http://studio.lan:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
# MUST be set explicitly -- Ollama truncates silently at its default, and a
# truncated prompt produces no error, just a model that appears stupid.
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=90000
# Client-side budget, deliberately well below num_ctx.
LLM_PROMPT_TOKEN_BUDGET=3000
# Handoff doc S16: strategic decisions every 30-90s, not per tick.
LLM_DECISION_COOLDOWN_MS=20000

ENABLE_AGENT_CODE_EXECUTION=false
